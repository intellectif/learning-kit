# Normalize line endings to LF in the repository and in working copies.
# Biome formats with LF; without this, Windows tooling (pnpm/npm rewriting a
# package.json, an editor save) reintroduces CRLF and `biome check` fails the
# lint task with a pure line-ending diff and no content change.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated; keep out of diffs and language stats.
pnpm-lock.yaml linguist-generated=true -diff
