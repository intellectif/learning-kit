{
  "name": "@intellectif/lk-practice",
  "version": "0.0.0",
  "private": true,
  "description": "Practice planning for a learner's skills: memory, ability and stage per skill over a prerequisite graph, as pure functions of a replayable log.",
  "keywords": [
    "spaced-repetition",
    "fsrs",
    "practice",
    "mastery",
    "skills",
    "learning",
    "edtech",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-practice#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-practice"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "vectors:memory": "node scripts/memory-vectors.mjs",
    "vectors:policy": "node scripts/policy-vectors.mjs && biome format --write vectors/evidence.json vectors/stage.json",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@intellectif/lk-core": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.6",
    "fast-check": "^4.10.2",
    "tsdown": "0.23.3",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  }
}
