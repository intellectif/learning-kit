            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "alt": {
              "type": "string",
