    "gap-select": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "gap-select"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "passage": {
          "type": "string",
          "minLength": 1
        },
        "passageHtml": {
          "type": "string"
        },
        "gaps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": {}
                }
              },
              "bankId": {
                "type": "string",
                "minLength": 1
              },
              "correctChoiceId": {
                "type": "string",
                "minLength": 1
              },
              "feedback": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "correctChoiceId"
            ],
            "additionalProperties": {}
          }
        },
        "banks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
