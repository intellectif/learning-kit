                "type": "string",
                "maxLength": 60
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "speaker",
              "text"
            ],
            "additionalProperties": {}
          }
        },
        "locale": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": {}
    },
    "item-group": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "item-group"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "slotKey": {
          "type": "string",
          "minLength": 1
        },
        "stimulus": {
          "$ref": "#/$defs/stimulus"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slotKey": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": {}
              },
              {
                "oneOf": [
                  {
                    "$ref": "#/$defs/multiple-choice"
                  },
                  {
                    "$ref": "#/$defs/fill-in-the-blanks"
                  },
                  {
                    "$ref": "#/$defs/written-response"
                  },
                  {
                    "$ref": "#/$defs/gap-select"
                  },
                  {
                    "$ref": "#/$defs/dictation"
                  },
                  {
                    "$ref": "#/$defs/read-aloud"
                  }
                ]
              }
            ]
          }
        },
        "shuffle": {
          "type": "string",
          "enum": [
            "none",
            "within-group"
          ]
        },
        "timeline": {
          "type": "object",
          "properties": {
            "cues": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "itemIds": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "at",
                  "itemIds"
                ],
                "additionalProperties": false
              }
            },
            "chapters": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "at",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "navigation": {
              "type": "string",
              "enum": [
                "free",
                "no-skip-ahead"
              ]
            }
          },
          "required": [
            "cues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "id",
        "stimulus",
        "items"
      ],
      "additionalProperties": {}
    }
  }
}
