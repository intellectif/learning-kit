            },
            "captionsUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "tracks": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "captions",
                      "subtitles"
                    ]
                  },
                  "src": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\/(?!\\/)\\S*$"
                      }
                    ]
                  },
                  "srclang": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "src",
                  "srclang",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "poster": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "playback": {
              "type": "object",
              "properties": {
                "controls": {
                  "type": "string",
                  "enum": [
                    "native",
                    "minimal"
                  ]
                },
                "maxPlays": {
                  "type": "integer",
                  "minimum": 1,
