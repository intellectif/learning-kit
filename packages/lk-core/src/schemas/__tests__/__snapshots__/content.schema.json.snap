              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "name",
                  "weight"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "criteria"
          ],
          "additionalProperties": {}
        },
        "languageTarget": {
          "type": "string"
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video",
                "embed"
