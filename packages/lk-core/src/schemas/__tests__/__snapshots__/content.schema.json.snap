{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SequenceEntry",
  "description": "One entry of a question set or an exam section: an activity, or an item group. Structural only: validateDraft and validateItemGroupDraft decide.",
  "oneOf": [
    {
      "$ref": "#/$defs/multiple-choice"
    },
    {
      "$ref": "#/$defs/fill-in-the-blanks"
    },
    {
      "$ref": "#/$defs/written-response"
    },
    {
      "$ref": "#/$defs/gap-select"
    },
    {
      "$ref": "#/$defs/dictation"
    },
    {
      "$ref": "#/$defs/read-aloud"
    },
    {
      "$ref": "#/$defs/item-group"
    }
  ],
  "$defs": {
    "multiple-choice": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "multiple-choice"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "questionHtml": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ]
        },
        "options": {
          "minItems": 2,
          "maxItems": 26,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "isCorrect": {
                "type": "boolean"
              },
              "feedback": {
                "type": "string"
              },
              "media": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "image",
                      "audio"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\/(?!\\/)\\S*$"
                      }
                    ]
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "captionsUrl": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\/(?!\\/)\\S*$"
                      }
                    ]
                  },
                  "transcript": {
                    "type": "string"
                  },
                  "script": {
                    "minItems": 1,
                    "maxItems": 500,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "speaker": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "speaker",
                        "text"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "text",
              "isCorrect"
            ],
            "additionalProperties": {}
          }
        },
        "scoringStrategy": {
          "type": "string",
          "enum": [
            "all-or-nothing",
            "partial"
          ]
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video",
                "embed"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "captionsUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "tracks": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "captions",
                      "subtitles"
                    ]
                  },
                  "src": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\/(?!\\/)\\S*$"
                      }
                    ]
                  },
                  "srclang": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "src",
                  "srclang",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "poster": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "playback": {
              "type": "object",
              "properties": {
                "controls": {
                  "type": "string",
                  "enum": [
                    "native",
                    "minimal"
                  ]
                },
                "maxPlays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "seek": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "none"
                  ]
                },
                "rate": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "fixed"
                  ]
                },
                "nativeControlHints": {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "hide-download",
                      "hide-rate"
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            "transcript": {
              "type": "string"
            },
            "script": {
              "minItems": 1,
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "speaker",
                  "text"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": {}
        },
        "feedback": {
          "type": "object",
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1
            },
            "incorrect": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": {}
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shuffle": {
          "type": "boolean"
        },
        "locale": {
          "type": "string"
        },
        "learningObjectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficultyLevel": {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "ai": {
          "type": "object",
          "properties": {
            "explanations": {
              "type": "boolean"
            },
            "hints": {
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "id",
        "title",
        "question",
        "mode",
        "options",
        "scoringStrategy"
      ],
      "additionalProperties": {}
    },
    "fill-in-the-blanks": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "fill-in-the-blanks"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "passage": {
          "type": "string",
          "minLength": 1
        },
        "passageHtml": {
          "type": "string"
        },
        "blanks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "acceptedAnswers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "caseSensitive": {
                "type": "boolean"
              },
              "trimWhitespace": {
                "type": "boolean"
              },
              "match": {
                "type": "object",
                "properties": {
                  "caseSensitive": {
                    "type": "boolean"
                  },
                  "trim": {
                    "type": "boolean"
                  },
                  "normalize": {
                    "type": "string",
                    "enum": [
                      "none",
                      "NFC",
                      "NFKC"
                    ]
                  },
                  "foldDiacritics": {
                    "type": "boolean"
                  },
                  "collapseInnerWhitespace": {
                    "type": "boolean"
                  },
                  "ignorePunctuation": {
                    "type": "boolean"
                  },
                  "levenshtein": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "locale": {
                    "type": "string"
                  }
                },
                "additionalProperties": {}
              },
              "hint": {
                "type": "string"
              },
              "feedback": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "acceptedAnswers"
            ],
            "additionalProperties": {}
          }
        },
        "scoringStrategy": {
          "type": "string",
          "enum": [
            "all-or-nothing",
            "partial"
          ]
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video",
                "embed"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "captionsUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "tracks": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "captions",
                      "subtitles"
                    ]
                  },
                  "src": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\/(?!\\/)\\S*$"
                      }
                    ]
                  },
                  "srclang": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "src",
                  "srclang",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "poster": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/(?!\\/)\\S*$"
                }
              ]
            },
            "playback": {
              "type": "object",
              "properties": {
                "controls": {
                  "type": "string",
                  "enum": [
                    "native",
                    "minimal"
                  ]
                },
                "maxPlays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "seek": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "none"
                  ]
                },
                "rate": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "fixed"
                  ]
                },
                "nativeControlHints": {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "hide-download",
                      "hide-rate"
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            "transcript": {
              "type": "string"
            },
            "script": {
              "minItems": 1,
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "speaker",
                  "text"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": {}
        },
        "feedback": {
          "type": "object",
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1
            },
            "incorrect": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": {}
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "locale": {
          "type": "string"
        },
        "learningObjectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficultyLevel": {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "ai": {
          "type": "object",
          "properties": {
            "explanations": {
              "type": "boolean"
            },
            "hints": {
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "id",
        "title",
        "passage",
        "blanks",
        "scoringStrategy"
      ],
      "additionalProperties": {}
    },
    "written-response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "written-response"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "promptHtml": {
          "type": "string"
        },
        "minWords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxWords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rubric": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "criteria": {
