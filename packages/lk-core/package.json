{
  "name": "@intellectif/lk-core",
  "version": "0.7.1",
  "description": "Framework-free assessment core: Zod activity schemas, pure scoring, rubric & deferred grading, weighted assessment composition, exam attempt plans, and xAPI 1.0.3.",
  "keywords": [
    "assessment",
    "exam",
    "quiz",
    "grading",
    "rubric",
    "scoring",
    "xapi",
    "tin-can",
    "elearning",
    "edtech",
    "lms",
    "h5p",
    "zod",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-core#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-core"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scoring": {
      "import": {
        "types": "./dist/scoring.d.ts",
        "default": "./dist/scoring.js"
      },
      "require": {
        "types": "./dist/scoring.d.cts",
        "default": "./dist/scoring.cjs"
      }
    },
    "./xapi": {
      "import": {
        "types": "./dist/xapi.d.ts",
        "default": "./dist/xapi.js"
      },
      "require": {
        "types": "./dist/xapi.d.cts",
        "default": "./dist/xapi.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "fast-check": "^3.22.0",
    "tsup": "^8.3.0",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
