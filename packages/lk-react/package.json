{
  "name": "@intellectif/lk-react",
  "version": "8.0.0",
  "description": "Accessible React 19 assessment components — multiple choice, fill-in-the-blanks, written response — with a resumable exam/review pager, theming, and xAPI delivery.",
  "keywords": [
    "react",
    "react19",
    "assessment",
    "exam",
    "quiz",
    "accessibility",
    "wcag",
    "xapi",
    "elearning",
    "edtech",
    "lms",
    "h5p",
    "components",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-react#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components/ActivityPreview": {
      "import": {
        "types": "./dist/components/ActivityPreview.d.ts",
        "default": "./dist/components/ActivityPreview.js"
      },
      "require": {
        "types": "./dist/components/ActivityPreview.d.cts",
        "default": "./dist/components/ActivityPreview.cjs"
      }
    },
    "./components/ActivitySequence": {
      "import": {
        "types": "./dist/components/ActivitySequence.d.ts",
        "default": "./dist/components/ActivitySequence.js"
      },
      "require": {
        "types": "./dist/components/ActivitySequence.d.cts",
        "default": "./dist/components/ActivitySequence.cjs"
      }
    },
    "./components/MultipleChoice": {
      "import": {
        "types": "./dist/components/MultipleChoice.d.ts",
        "default": "./dist/components/MultipleChoice.js"
      },
      "require": {
        "types": "./dist/components/MultipleChoice.d.cts",
        "default": "./dist/components/MultipleChoice.cjs"
      }
    },
    "./components/FillInTheBlanks": {
      "import": {
        "types": "./dist/components/FillInTheBlanks.d.ts",
        "default": "./dist/components/FillInTheBlanks.js"
      },
      "require": {
        "types": "./dist/components/FillInTheBlanks.d.cts",
        "default": "./dist/components/FillInTheBlanks.cjs"
      }
    },
    "./components/StimulusPanel": {
      "import": {
        "types": "./dist/components/StimulusPanel.d.ts",
        "default": "./dist/components/StimulusPanel.js"
      },
      "require": {
        "types": "./dist/components/StimulusPanel.d.cts",
        "default": "./dist/components/StimulusPanel.cjs"
      }
    },
    "./components/WrittenResponse": {
      "import": {
        "types": "./dist/components/WrittenResponse.d.ts",
        "default": "./dist/components/WrittenResponse.js"
      },
      "require": {
        "types": "./dist/components/WrittenResponse.d.cts",
        "default": "./dist/components/WrittenResponse.cjs"
      }
    },
    "./hooks/useActivityState": {
      "import": {
        "types": "./dist/hooks/useActivityState.d.ts",
        "default": "./dist/hooks/useActivityState.js"
      },
      "require": {
        "types": "./dist/hooks/useActivityState.d.cts",
        "default": "./dist/hooks/useActivityState.cjs"
      }
    },
    "./hooks/useXAPI": {
      "import": {
        "types": "./dist/hooks/useXAPI.d.ts",
        "default": "./dist/hooks/useXAPI.js"
      },
      "require": {
        "types": "./dist/hooks/useXAPI.d.cts",
        "default": "./dist/hooks/useXAPI.cjs"
      }
    },
    "./i18n/LkIntlProvider": {
      "import": {
        "types": "./dist/i18n/LkIntlProvider.d.ts",
        "default": "./dist/i18n/LkIntlProvider.js"
      },
      "require": {
        "types": "./dist/i18n/LkIntlProvider.d.cts",
        "default": "./dist/i18n/LkIntlProvider.cjs"
      }
    },
    "./theme/ThemeProvider": {
      "import": {
        "types": "./dist/theme/ThemeProvider.d.ts",
        "default": "./dist/theme/ThemeProvider.js"
      },
      "require": {
        "types": "./dist/theme/ThemeProvider.d.cts",
        "default": "./dist/theme/ThemeProvider.cjs"
      }
    },
    "./theme/defaults.css": "./dist/theme/defaults.css",
    "./theme/skin.css": "./dist/theme/skin.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "e2e": "playwright test -c ../../playwright.config.ts",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "attw": "attw --pack . --ignore-rules no-resolution --exclude-entrypoints \"theme/defaults.css\" \"theme/skin.css\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@intellectif/lk-core": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@intellectif/lk-core": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "msw": "^2.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "vitest": "^4.1.6",
    "vitest-axe": "^0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
