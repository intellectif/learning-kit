{
  "name": "@intellectif/lk-interactive-activities",
  "version": "0.3.0",
  "description": "Contracts and React players for hosted interactive activities — What Happens and Cine-Scramble — with zero runtime dependencies.",
  "keywords": [
    "react",
    "react19",
    "interactive-activities",
    "elearning",
    "edtech",
    "lms",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-interactive-activities#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-interactive-activities"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./player": {
      "import": {
        "types": "./dist/player.d.ts",
        "default": "./dist/player.js"
      },
      "require": {
        "types": "./dist/player.d.cts",
        "default": "./dist/player.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@intellectif/lk-core": "workspace:^",
    "@intellectif/lk-react": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@intellectif/lk-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@intellectif/lk-core": "workspace:*",
    "@intellectif/lk-react": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.5",
    "vitest": "^4.1.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.1.3",
    "@playwright/test": "^1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
