{
  "name": "@intellectif/lk-interactive-activities",
  "version": "0.0.0",
  "description": "React player and activity contracts for hosted interactive activities — starting with What Happens and Cine-Scramble — with zero runtime dependencies.",
  "keywords": [
    "react",
    "react19",
    "interactive-activities",
    "elearning",
    "edtech",
    "lms",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-interactive-activities#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-interactive-activities"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@intellectif/lk-core": "workspace:^",
    "@intellectif/lk-react": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@intellectif/lk-core": "workspace:*",
    "@intellectif/lk-react": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.5",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
