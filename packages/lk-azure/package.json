{
  "name": "@intellectif/lk-azure",
  "version": "2.0.0",
  "description": "Azure AI Speech pronunciation assessment results, read into lk-core's SpeechAssessment: pure, no network, no key, checked against real captured responses.",
  "keywords": [
    "azure",
    "speech",
    "pronunciation",
    "pronunciation-assessment",
    "read-aloud",
    "assessment",
    "edtech",
    "typescript"
  ],
  "homepage": "https://github.com/intellectif/learning-kit/tree/main/packages/lk-azure#readme",
  "bugs": {
    "url": "https://github.com/intellectif/learning-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectif/learning-kit.git",
    "directory": "packages/lk-azure"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "publint": "publint",
    "verify-dist": "node scripts/verify-dist.mjs",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@intellectif/lk-core": "workspace:^"
  },
  "devDependencies": {
    "@intellectif/lk-core": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.6",
    "tsdown": "0.23.3",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
