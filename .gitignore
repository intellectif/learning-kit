.size-limit-result.json

# Environment variables
.env
.env.*
!.env.example

# Changesets pre-release state
.changeset/pre.json

# Editor & OS artifacts
.DS_Store
Thumbs.db
*.log
*.local

# pnpm virtual store (generated)
.pnpm-store/
