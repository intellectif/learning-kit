{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // 4 MiB, where Biome's default is 1 MiB. `packages/lk-core/vectors/scoring.json` is a
    // generated grade-stability corpus that grows with every milestone, and it is already
    // within 15 KB of that default. Past it Biome skips the file, and neither consequence
    // is one you would guess from its symptom: `biome check .` still exits 0 — the corpus
    // is simply no longer checked, and the only sign is the checked-file count dropping by
    // one — while `biome format --write`, which `packages/lk-core/scripts/generate-vectors.mjs`
    // runs as its last step, exits 1 AFTER the corpus has been written, so the generator
    // fails with the new corpus already on disk. A ceiling well clear of the corpus makes
    // crossing it a decision somebody takes, rather than a milestone walking into it.
    //
    // This file is `.jsonc` for this comment: Biome 2.4 parses `biome.json` as strict JSON
    // and, given a comment, falls back to its built-in defaults without saying so.
    "maxSize": 4194304
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // The interactive video's keyed state (`keyed-state.ts`): the ref
            // and the setters keep one identity for the life of the player,
            // like a `useRef` and a `useState` setter; the state itself does not.
            "hooks": [
              { "name": "useKeySet", "stableResult": [1, 2] },
              { "name": "useKeyMap", "stableResult": [1] }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // lk-core's zod is bundled into every app that imports it. zod's `z` is an
      // object holding all of zod — every locale included — so a bundler keeps
      // all of it once one module imports it by name (~50 kB brotli, measured by
      // `pnpm size`). A namespace import is shaken to what is used.
      "includes": ["packages/lk-core/src/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod/v4": {
                    "importNames": ["z", "default"],
                    "message": "Import zod as a namespace (`import * as z from 'zod/v4'`): the named `z` brings every zod locale into an app's bundle."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
