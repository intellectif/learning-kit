{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // 4 MiB, where Biome's default is 1 MiB. `packages/lk-core/vectors/scoring.json` is a
    // generated grade-stability corpus that grows with every milestone, and it is already
    // within 15 KB of that default. Past it Biome skips the file, and neither consequence
    // is one you would guess from its symptom: `biome check .` still exits 0 — the corpus
    // is simply no longer checked, and the only sign is the checked-file count dropping by
    // one — while `biome format --write`, which `packages/lk-core/scripts/generate-vectors.mjs`
    // runs as its last step, exits 1 AFTER the corpus has been written, so the generator
    // fails with the new corpus already on disk. A ceiling well clear of the corpus makes
    // crossing it a decision somebody takes, rather than a milestone walking into it.
    //
    // This file is `.jsonc` for this comment: Biome 2.4 parses `biome.json` as strict JSON
    // and, given a comment, falls back to its built-in defaults without saying so.
    "maxSize": 4194304
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // The interactive video's keyed state (`keyed-state.ts`): the ref
            // and the setters keep one identity for the life of the player,
            // like a `useRef` and a `useState` setter; the state itself does not.
            "hooks": [
              { "name": "useKeySet", "stableResult": [1, 2] },
              { "name": "useKeyMap", "stableResult": [1] }
            ]
          }
        }
      }
    }
  },
  // Reports `Math.random` in lk-practice's source; see the lk-practice
  // override below for the globals.
  "plugins": [
    {
      "path": "./packages/lk-practice/lint/no-math-random.grit",
      "includes": ["packages/lk-practice/src/**", "!**/__tests__/**"]
    }
  ],
  "overrides": [
    {
      // lk-core's zod is bundled into every app that imports it. zod's `z` is an
      // object holding all of zod — every locale included — so a bundler keeps
      // all of it once one module imports it by name (~50 kB brotli, measured by
      // `pnpm size`). A namespace import is shaken to what is used.
      "includes": ["packages/lk-core/src/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod/v4": {
                    "importNames": ["z", "default"],
                    "message": "Import zod as a namespace (`import * as z from 'zod/v4'`): the named `z` brings every zod locale into an app's bundle."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      // lk-practice is pure (requirement R1.1): every result is a function of
      // its arguments alone, so time, randomness and I/O come in as arguments.
      // These globals would read them from the environment instead. Tests may
      // use them; `scripts/verify-dist.mjs` checks the built files as well.
      // `Math.random` is a member, not a global, so the plugin under `plugins`
      // reports it.
      "includes": ["packages/lk-practice/src/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "lk-practice is pure (R1.1): take the time as an argument (`now`) instead of reading the clock.",
                  "performance": "lk-practice is pure (R1.1): take the time as an argument instead of reading the clock.",
                  "crypto": "lk-practice is pure (R1.1): take a seed argument instead of reading random values.",
                  "setTimeout": "lk-practice is pure (R1.1): it schedules nothing; return the due time instead.",
                  "setInterval": "lk-practice is pure (R1.1): it schedules nothing; return the due time instead.",
                  "setImmediate": "lk-practice is pure (R1.1): it schedules nothing; return the due time instead.",
                  "clearTimeout": "lk-practice is pure (R1.1): it schedules nothing.",
                  "clearInterval": "lk-practice is pure (R1.1): it schedules nothing.",
                  "queueMicrotask": "lk-practice is pure (R1.1): it schedules nothing.",
                  "fetch": "lk-practice is pure (R1.1): it does no I/O; the host passes the data in.",
                  "XMLHttpRequest": "lk-practice is pure (R1.1): it does no I/O; the host passes the data in.",
                  "WebSocket": "lk-practice is pure (R1.1): it does no I/O; the host passes the data in.",
                  "process": "lk-practice is pure (R1.1): it reads no environment; take a configuration argument."
                }
              }
            }
          }
        }
      }
    },
    {
      // Tests, and only tests: a test defines the component it renders inside
      // its own callback, closing over that test's fixtures. The callback runs
      // once, so the component keeps one identity for the whole test, and the
      // state loss this rule guards against cannot happen. In the packages'
      // source the rule stays on.
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  // Biome reads JavaScript, TypeScript and JSON here, and nothing else. From
  // 2.6 it also formats Markdown and YAML, which would fight the tools that
  // write some of them (pnpm writes `pnpm-lock.yaml`, Changesets writes the
  // CHANGELOGs), and would change what the docs render: it removes the blank
  // lines that make a list loose, and pads every table row to its widest cell.
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
