{
  "name": "learning-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for the Intellectif Learning Kit SDK",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:repo": "biome check --error-on-warnings .",
    "coverage": "turbo run coverage",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify-release": "turbo run build test lint typecheck publint attw verify-dist && pnpm lint:repo && pnpm api-check && pnpm docs-check && pnpm size",
    "release": "pnpm run verify-release && changeset publish",
    "size": "size-limit",
    "e2e": "turbo run e2e",
    "check-packaging": "turbo run publint attw verify-dist",
    "api-report": "node scripts/api-report.mjs",
    "api-check": "node scripts/api-report.mjs --check",
    "docs-check": "node scripts/check-readme-packages.mjs && node scripts/check-changesets.mjs && node scripts/check-release-plan.mjs && node scripts/check-doc-links.mjs && node scripts/check-doc-imports.mjs",
    "mutate": "node scripts/mutate.mjs"
  },
  "keywords": [],
  "author": "Intellectif LLC",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "2.31.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.2",
    "publint": "^0.3.24",
    "size-limit": "^13.1.1",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
